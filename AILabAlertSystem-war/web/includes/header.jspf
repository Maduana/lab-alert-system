<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lab Alert System</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="${pageContext.request.contextPath}/assets/css/style.css">
</head>
<body class="app-body">

<nav class="navbar navbar-expand-lg topbar shadow-sm">
    <div class="container">
        <a class="navbar-brand brand-wrap" href="${pageContext.request.contextPath}/dashboard">
            <span class="brand-logo-shell">
                <img src="${pageContext.request.contextPath}/assets/images/logo.png"
                     alt="Lab Alert System logo"
                     class="brand-logo">
            </span>

            <span class="brand-copy">
                <span class="brand-title">Lab Alert System</span>
                <span class="brand-subtitle">AI-based result flagging & alerts</span>
            </span>
        </a>

        <div class="ms-auto d-flex align-items-center gap-2">
            <c:if test="${not empty sessionScope.loggedInUser}">
                <span class="welcome-pill">
                    Welcome, ${sessionScope.loggedInUser.fullName}
                </span>

                <a class="btn btn-sm btn-light logout-btn"
                   href="${pageContext.request.contextPath}/logout">
                    Logout
                </a>
            </c:if>
        </div>
    </div>
</nav>

<div class="container py-4">